#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

/* Create the 5 x 5 Playfair matrix */
void createMatrix(char key[])
{
    int used[26] = {0};
    int row = 0, col = 0;
    int i;
    char ch;

    /* I and J are treated as the same letter */
    used['J' - 'A'] = 1;

    for (i = 0; key[i] != '\0'; i++)
    {
        ch = toupper(key[i]);

        if (ch < 'A' || ch > 'Z')
            continue;

        if (ch == 'J')
            ch = 'I';

        if (!used[ch - 'A'])
        {
            matrix[row][col] = ch;
            used[ch - 'A'] = 1;

            col++;

            if (col == 5)
            {
                col = 0;
                row++;
            }
        }
    }

    /* Fill remaining letters */
    for (ch = 'A'; ch <= 'Z'; ch++)
    {
        if (!used[ch - 'A'])
        {
            matrix[row][col] = ch;
            used[ch - 'A'] = 1;

            col++;

            if (col == 5)
            {
                col = 0;
                row++;
            }
        }
    }
}

/* Find the position of a letter in the matrix */
void findPosition(char ch, int *row, int *col)
{
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++)
    {
        for (j = 0; j < 5; j++)
        {
            if (matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

/* Encrypt a pair of letters */
void encryptPair(char a, char b, char *x, char *y)
{
    int r1, c1, r2, c2;

    findPosition(a, &r1, &c1);
    findPosition(b, &r2, &c2);

    /* Same row */
    if (r1 == r2)
    {
        *x = matrix[r1][(c1 + 1) % 5];
        *y = matrix[r2][(c2 + 1) % 5];
    }

    /* Same column */
    else if (c1 == c2)
    {
        *x = matrix[(r1 + 1) % 5][c1];
        *y = matrix[(r2 + 1) % 5][c2];
    }

    /* Rectangle rule */
    else
    {
        *x = matrix[r1][c2];
        *y = matrix[r2][c1];
    }
}

int main()
{
    char key[100];
    char plaintext[1000];
    char prepared[1000];
    char ciphertext[1000];

    int i, j = 0;
    int len;

    printf("Enter keyword: ");
    scanf("%99s", key);

    createMatrix(key);

    printf("\nPlayfair Matrix:\n");

    for (i = 0; i < 5; i++)
    {
        for (j = 0; j < 5; j++)
        {
            printf("%c ", matrix[i][j]);
        }
        printf("\n");
    }

    getchar();

    printf("\nEnter plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);

    /* Prepare plaintext */
    for (i = 0; plaintext[i] != '\0'; i++)
    {
        if (isalpha(plaintext[i]))
        {
            char ch = toupper(plaintext[i]);

            if (ch == 'J')
                ch = 'I';

            prepared[j++] = ch;
        }
    }

    prepared[j] = '\0';

    /* Insert X between repeated letters */
    char temp[1000];
    int k = 0;

    for (i = 0; prepared[i] != '\0'; i++)
    {
        temp[k++] = prepared[i];

        if (prepared[i] == prepared[i + 1])
            temp[k++] = 'X';
    }

    /* Add X if length is odd */
    if (k % 2 != 0)
        temp[k++] = 'X';

    temp[k] = '\0';

    /* Encrypt pairs */
    j = 0;

    for (i = 0; i < k; i += 2)
    {
        encryptPair(temp[i], temp[i + 1],
                    &ciphertext[j], &ciphertext[j + 1]);

        j += 2;
    }

    ciphertext[j] = '\0';

    printf("\nPrepared plaintext: %s", temp);
    printf("\nCiphertext: %s\n", ciphertext);

    return 0;
}
