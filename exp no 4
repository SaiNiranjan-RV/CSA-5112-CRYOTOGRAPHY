```c
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char plaintext[1000];
    char key[100];
    char ciphertext[1000];

    int i, j = 0;
    int keyLen;

    printf("Enter plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);

    printf("Enter key: ");
    scanf("%99s", key);

    keyLen = strlen(key);

    /* Encrypt plaintext */
    for (i = 0; plaintext[i] != '\0'; i++)
    {
        if (isalpha(plaintext[i]))
        {
            char p = toupper(plaintext[i]);
            char k = toupper(key[j % keyLen]);

            ciphertext[i] = ((p - 'A') + (k - 'A')) % 26 + 'A';

            j++;
        }
        else
        {
            /* Keep spaces and special characters unchanged */
            ciphertext[i] = plaintext[i];
        }
    }

    ciphertext[i] = '\0';

    printf("\nCiphertext: %s", ciphertext);

    return 0;
}
